# ============================================================
# LLM Provider — 内部多模型网关 (llm-gw)
# ============================================================
JD_LLM_API_KEY=your_key_here
JD_LLM_BASE_URL=https://your-internal-gateway.example.com/v1
# 默认模型（可在网页右上角切换）。可选值：
#   Gemini-3-Flash-Preview-joybuilder  (Gemini 3 Flash，默认)
#   Claude-Sonnet-4.6-joybuilder       (Claude Sonnet 4.6)
#   DeepSeek-V4-Pro-joybuilder         (DeepSeek V4 Pro)
XIAOSHU_MODEL=Gemini-3-Flash-Preview-joybuilder

